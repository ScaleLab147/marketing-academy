# 필요한 환경 변수의 "이름"만 적어 둔 견본입니다. 실제 값은 여기에 쓰지 마세요 (이 파일은 GitHub에 올라갑니다).
# 새 기기·새 직원: 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다. .env.local 은 GitHub에 올라가지 않습니다.
# 운영 사이트: 같은 이름으로 Vercel 프로젝트 > Settings > Environment Variables 에 넣습니다.

# Supabase (회원 로그인·가입)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 토스페이먼츠 (결제)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
